# Copy this to .env (not committed) for local development
# For production, set these in Vercel Environment Variables

DATABASE_URL="mongodb://localhost:27017/e-learning"
PORT=3001
JWT_SECRET="your-jwt-secret"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URL - MUST be set in Vercel for CORS to work
FRONTEND_URL="https://codeefather.netlify.app"

# Stripe (optional - will use mock mode if not set)
STRIPE_SECRET_KEY="sk_test_your_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# PayPal (for subscription authorizations)
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_SECRET="your-paypal-secret"
PAYPAL_ENV="sandbox"

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""